# Kilo server environment. Names only; never commit real values.

# --- Core ---
NODE_ENV=
DATABASE_URL=
PORT=
KILO_PUBLIC_URL=

# --- Auth: dev | supabase. Required, no default (npm run dev sets dev); dev is refused when NODE_ENV=production ---
KILO_AUTH=
# HS256 tokens (legacy JWT secret). Asymmetric signing keys are checked via SUPABASE_URL's JWKS.
SUPABASE_JWT_SECRET=

# --- Storage: local | supabase ---
KILO_STORAGE=
KILO_STORAGE_DIR=
KILO_BUCKET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: added as the `apikey` header on tus upload targets if the gateway needs it.
SUPABASE_ANON_KEY=
# Optional: HMAC secret for local storage links. Unset: kept in <KILO_STORAGE_DIR>/.local-signing-secret.
# Required (32+ random characters) when KILO_STORAGE=local and NODE_ENV=production.
KILO_LOCAL_SIGNING_SECRET=
# Optional: largest file one upload may carry, bytes (default 2147483648).
KILO_MAX_UPLOAD_BYTES=
# Optional: lifetime of signed download URLs in seconds (default 3600).
KILO_URL_TTL_SEC=
# Optional: browser origins allowed to call the API, comma separated (default: any origin).
KILO_CORS_ORIGINS=
# Optional: largest JSON request body, bytes (default 2097152). File bytes go to upload targets instead.
KILO_MAX_BODY_BYTES=

# --- Per-user limits (429 when reached; 0 turns one off) ---
# Videos uploading, queued or analysing at once (default 150).
KILO_MAX_ACTIVE_VIDEOS=
# Renders queued or rendering at once (default 300: a whole batch of 50 videos with 5 openings each).
KILO_MAX_QUEUED_RENDERS=
# Replans of one video per hour (default 12).
KILO_MAX_REPLANS_PER_HOUR=
# New batches per 24 hours (default 40).
KILO_MAX_BATCHES_PER_DAY=

# --- Push: expo | log ---
KILO_PUSH=
EXPO_ACCESS_TOKEN=

# --- Worker ---
# real (loads @kilo/analyze, @kilo/render, @kilo/templates) | fake
KILO_PIPELINE=
KILO_WORK_DIR=
KILO_ANALYZE_CONCURRENCY=
KILO_RENDER_CONCURRENCY=
KILO_JOB_RETRY_LIMIT=
# A running job not heard from (heartbeat) for this long is retried by another worker, seconds (default 90).
KILO_JOB_EXPIRE_SEC=
# Storage with no matching video is swept once its newest file is older than this, seconds (default 21600, min 3600).
KILO_SWEEP_GRACE_SEC=
# On SIGTERM, how long running jobs get before they are handed back to the queue, ms (default 8000).
KILO_STOP_GRACE_MS=
# 1 lets a production worker run with an offline transcriber or decider (fixture, heuristic, fake pipeline).
KILO_ALLOW_STAND_INS=

# --- Pipeline providers (read by @kilo/analyze, see docs/CONTRACTS.md section 4) ---
KILO_TRANSCRIBER=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Optional: upload cap of the OpenAI-compatible endpoint; longer audio is sent in pieces cut on pauses (default 25165824).
KILO_OPENAI_MAX_UPLOAD_BYTES=
# KILO_TRANSCRIBER=whisper: a local Whisper model on the CPU, free, no key. Chosen only by name.
# Set up with `npm run whisper:setup` in packages/analyze, or build the image with --build-arg KILO_WITH_WHISPER=1.
# Python with faster-whisper (default packages/analyze/.work/whisper-venv/bin/python, else python3).
KILO_WHISPER_PYTHON=
# Model: base.en (default; most accurate on Kilo's real-speech tests and the fastest), small.en,
# large-v3-turbo (int8, multilingual, about 2.5 s of CPU per second of audio), a Hugging Face repo id, or a local model directory.
KILO_WHISPER_MODEL=
# Where the model is downloaded (default packages/analyze/.work/whisper-models, gitignored).
KILO_WHISPER_CACHE_DIR=
# CPU threads per transcription (default 2).
KILO_WHISPER_THREADS=
# Replaces the disfluent prompt that keeps "um" and "uh" (empty: Kilo's prompt; "none": no prompt).
KILO_WHISPER_PROMPT=
# 1 lets the worker download a missing model on first use (default: fail with a setup message).
KILO_WHISPER_ALLOW_DOWNLOAD=
# Empty (default): check Whisper's words and edges against a small CTC model (wav2vec2-base-960h, 378 MB,
# downloaded by whisper:setup; about 0.16 s more CPU per second of audio). none: Whisper alone.
KILO_WHISPER_ALIGN=
KILO_DECIDER=
ANTHROPIC_API_KEY=
KILO_CLAUDE_MODEL=
PEXELS_API_KEY=

# --- Templates (read by @kilo/templates) ---
KILO_TEMPLATES_CACHE_DIR=
KILO_TEMPLATES_CACHE_MAX_MB=
KILO_TEMPLATES_CACHE_MAX_AGE_DAYS=
KILO_CHROMIUM_PATH=
